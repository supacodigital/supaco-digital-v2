# Formulaire de contact — envoi des e-mails via Resend.
# Copier ce fichier en `.env.local` (dev) et renseigner les valeurs réelles.
# `.env*` est ignoré par git : ne jamais committer la clé.

# Clé API Resend — https://resend.com/api-keys
# Obligatoire en production. Sans elle, l'envoi échoue (et le formulaire
# affiche une erreur au visiteur plutôt que de faire croire à un succès).
RESEND_API_KEY=

# Destinataire des demandes de contact.
CONTACT_EMAIL_TO=contact@supaco-digital.com

# Expéditeur. Le domaine doit être vérifié dans Resend (enregistrements DNS).
# La réception reste gérée par Google Workspace : Resend ne sert qu'à l'envoi.
CONTACT_EMAIL_FROM="Supaco Digital <contact@supaco-digital.com>"
